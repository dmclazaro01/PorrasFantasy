# --- Frontend (Vite) ---
# Copia este archivo a .env.local y rellena con los datos de tu proyecto Supabase.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...tu-anon-key...

# --- Solo backend (importador / Edge Function / cron). NO se exponen al frontend. ---
# Se pasan por env al script o como secrets en Supabase, no aqui:
#   FOOTBALL_DATA_TOKEN=xxxxxxxx     (football-data.org, gratis)
#   SUPABASE_SERVICE_ROLE_KEY=xxxx   (la da Supabase, Settings -> API)
